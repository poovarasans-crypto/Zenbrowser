{
  "name": "zenbrowser",
  "version": "1.0.0",
  "private": true,
  "description": "A restricted URL browser with serial hardware connectivity",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "postinstall": "electron-rebuild -f -w serialport"
  },
  "dependencies": {
    "electron": "^45.4.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@electron/rebuild": "^4.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
